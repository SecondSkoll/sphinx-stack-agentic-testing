{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["openrouter"],
  "default_agent": "sphinx-stack-agent",
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "provider": {
    "openrouter-zdr": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter ZDR",
      "options": {
        "apiKey": "{file:/project/.key}",
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "openai/gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "options": {
            "provider": {
              "zdr": true
            }
          }
        }
      }
    }
  },
  "references": {
    "generic-agentic-workflows": {
      "repository": "SecondSkoll/generic-agentic-workflows",
      "branch": "test/docs",
      "description": "Read-only Markdown documentation source corpus. Record its resolved commit, copy relevant documentation and assets into a disposable in-repository scenario directory, and create test-owned standalone Sphinx Stack scaffolding around that copy. Never edit the reference directory or cache."
    }
  }
}